[Unit]
Description=DeFi Sentinel Bot (v3.2 User Mode)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/defi_agents
EnvironmentFile=%h/projects/defi_agents/.env
Environment=PYTHONPATH=%h/projects/defi_agents/src
ExecStart=%h/projects/defi_agents/.venv/bin/python %h/projects/defi_agents/main.py
TimeoutStartSec=300

[Install]
WantedBy=default.target
