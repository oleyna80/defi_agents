[Unit]
Description=DeFi Sentinel Bot (v3.2 User Mode)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/dmitrii/projects/defi_agents
EnvironmentFile=/home/dmitrii/projects/defi_agents/.env
Environment=PYTHONPATH=/home/dmitrii/projects/defi_agents/src
ExecStart=/home/dmitrii/projects/defi_agents/.venv/bin/python /home/dmitrii/projects/defi_agents/main.py
TimeoutStartSec=300

[Install]
WantedBy=default.target
